{
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "C:\\Services\\CustomServices\\ArabicVerbGeneratorServices\\ArabicVerbGenerator.Worker.Service\\logs\\log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:HH:mm:ss}] [{Level:u3}] {Message:lj} {NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithExceptionDetails" ]
  },
  "BatchFilePath": "C:\\Services\\CustomServices\\ArabicVerbGeneratorServices\\run.bat",
  "CronScheduleConfig": "0 22 * * *"
}